    {
        "id": "04a299b0e7898d36",
        "type": "function",
        "z": "5e9f9f71afbfcb1c",
        "name": "Processar Dados",
        "func": "// Clona a mensagem original para evitar modificações que afetem o objeto _res da resposta HTTP\nconst originalMsg = RED.util.cloneMessage(msg);\n\n// Garante que msg.payload seja sempre um objeto (caso o parser JSON falhe ou não seja string)\nif (typeof originalMsg.payload === \"string\") {\n    try {\n        originalMsg.payload = JSON.parse(originalMsg.payload);\n    } catch (e) {\n        node.error(\"Erro ao fazer parse do JSON: \" + e.message, originalMsg);\n        // Prepara uma mensagem de erro para a resposta HTTP e retorna null para outras saídas\n        originalMsg.payload = `Erro ao fazer parse do JSON: ${e.message}`;\n        originalMsg.statusCode = 400; // Define o status HTTP para erro\n        return [null, null, null, null, null, null, null, null, null, null, originalMsg];\n    }\n}\n\n// Validação de campos obrigatórios\nconst camposObrigatorios = [\"ID\", \"Sensor\", \"IP\", \"MAC\", \"Temperatura\", \"Umidade\", \"GasFumaca\", \"Movimento\", \"Alerta\"];\nfor (let campo of camposObrigatorios) {\n    if (!(campo in originalMsg.payload)) {\n        node.error(`Campo faltando: ${campo}`, originalMsg);\n        // Prepara uma mensagem de erro para a resposta HTTP e retorna null para outras saídas\n        originalMsg.payload = `Erro: Campo obrigatório '${campo}' faltando.`;\n        originalMsg.statusCode = 400; // Define o status HTTP para erro\n        return [null, null, null, null, null, null, null, null, null, null, originalMsg];\n    }\n}\n\nconst now = new Date();\n\n// Armazena dados no contexto global (para o Painel Principal e Histórico)\nglobal.set('ultimaLeitura', {\n    timestamp: now,\n    data: originalMsg.payload\n});\n\n// Adiciona ao histórico (limitando a 50 registros)\nconst historico = global.get('historico') || [];\nhistorico.push({\n    timestamp: now.getTime(), // Armazena timestamp numérico para fácil serialização/uso\n    data: originalMsg.payload\n});\nif (historico.length > 50) historico.shift(); \nglobal.set('historico', historico);\n\n// Prepara mensagens para diferentes saídas\nconst outputMsgs = new Array(11).fill(null); // 10 UI + 1 HTTP Response\n\n// 1. Informações do dispositivo (ui_template: Informações do Dispositivo)\noutputMsgs[0] = {\n    topic: \"info\",\n    payload: {\n        ID: originalMsg.payload.ID,\n        Sensor: originalMsg.payload.Sensor,\n        IP: originalMsg.payload.IP,\n        MAC: originalMsg.payload.MAC\n    }\n};\n\n// 2. Dados para gráficos com histórico (ui_chart: Histórico Temperatura)\noutputMsgs[1] = {\n    topic: \"Temperatura\",\n    payload: {\n        series: [\"Temperatura\"],\n        data: [[originalMsg.payload.Temperatura]],\n        labels: [now.toLocaleTimeString()],\n        timestamp: now.getTime()\n    }\n};\n\n// 3. Dados para gráficos com histórico (ui_chart: Histórico Umidade)\noutputMsgs[2] = {\n    topic: \"Umidade\",\n    payload: {\n        series: [\"Umidade\"],\n        data: [[originalMsg.payload.Umidade]],\n        labels: [now.toLocaleTimeString()],\n        timestamp: now.getTime()\n    }\n};\n\n// 4. Dados para gráficos com histórico (ui_chart: Histórico Gás/Fumaça)\noutputMsgs[3] = {\n    topic: \"Gas\",\n    payload: {\n        series: [\"Gás/Fumaça\"],\n        data: [[originalMsg.payload.GasFumaca]],\n        labels: [now.toLocaleTimeString()],\n        timestamp: now.getTime()\n    }\n};\n\n// 5. Dados atuais para medidores (ui_gauge: Medidor Temperatura)\noutputMsgs[4] = {\n    topic: \"temp_gauge\",\n    payload: originalMsg.payload.Temperatura\n};\n\n// 6. Dados atuais para medidores (ui_gauge: Medidor Umidade)\noutputMsgs[5] = {\n    topic: \"umid_gauge\",\n    payload: originalMsg.payload.Umidade\n};\n\n// 7. Dados atuais para medidores (ui_gauge: Medidor Gás/Fumaça)\noutputMsgs[6] = {\n    topic: \"gas_gauge\",\n    payload: originalMsg.payload.GasFumaca\n};\n\n// 8. Status de alerta (ui_template: Status de Alerta)\noutputMsgs[7] = {\n    topic: \"alerta\",\n    payload: originalMsg.payload.Alerta\n};\n\n// 9. Dados para template principal (ui_template: Painel Principal) - envia o payload completo\noutputMsgs[8] = {\n    topic: \"dashboard\",\n    payload: originalMsg.payload // O template pode acessar msg.payload.Temperatura, etc.\n};\n\n// 10. Dados para histórico de eventos (ui_template: Histórico de Eventos) - envia o histórico completo\noutputMsgs[9] = {\n    topic: \"historico_eventos\",\n    payload: historico // Envia o array de histórico diretamente\n};\n\n// Resposta HTTP (última saída - preserve o objeto original para a resposta HTTP)\n// A mensagem original (msg) precisa ser passada para o http response\noriginalMsg.payload = \"Dados recebidos e processados com sucesso!\";\noriginalMsg.statusCode = 200; // Define o status HTTP para sucesso\noutputMsgs[10] = originalMsg; // Atribui a mensagem original à última saída\n\n// Retorna as mensagens para as saídas configuradas\nreturn outputMsgs;",
        "outputs": 11,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
