    {
        "id": "9e2bd0af9b40a81a",
        "type": "ui_template",
        "z": "5e9f9f71afbfcb1c",
        "group": "2dea889fc09bd884",
        "name": "Painel Principal",
        "order": 10,
        "width": "12",
        "height": "8",
        "format": "<div style='padding:20px; font-family:Arial; background:#f5f7fa; border-radius:10px'>\n  \n  <div style='background:#2c3e50; color:white; padding:15px; border-radius:8px; margin-bottom:20px; box-shadow:0 3px 6px rgba(0,0,0,0.16)'>\n    <h1 style='margin:0; font-size:1.8em'><i class='fa fa-heartbeat'></i> BioSentinela - Monitoramento Ambiental</h1>\n    <p style='margin:5px 0 0 0; font-size:0.9em; opacity:0.8'>\n      <i class='fa fa-clock-o'></i> Última atualização: {{new Date(global.get('ultimaLeitura').timestamp).toLocaleString()}}\n    </p>\n  </div>\n  \n  \n  <div style='display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); gap:20px; margin-bottom:20px'>\n    \n    <div style='background:white; padding:20px; border-radius:8px; box-shadow:0 3px 6px rgba(0,0,0,0.1); border-top:4px solid #e74c3c'>\n      <div style='display:flex; justify-content:space-between; align-items:center; margin-bottom:15px'>\n        <h2 style='margin:0; color:#e74c3c'><i class='fa fa-thermometer-three-quarters'></i> Temperatura</h2>\n        <div style='font-size:2.2em; font-weight:bold'>{{global.get('ultimaLeitura').data.Temperatura}} <span style='font-size:0.6em'>°C</span></div>\n      </div>\n    </div>\n    \n    \n    <div style='background:white; padding:20px; border-radius:8px; box-shadow:0 3px 6px rgba(0,0,0,0.1); border-top:4px solid #3498db'>\n      <div style='display:flex; justify-content:space-between; align-items:center; margin-bottom:15px'>\n        <h2 style='margin:0; color:#3498db'><i class='fa fa-tint'></i> Umidade</h2>\n        <div style='font-size:2.2em; font-weight:bold'>{{global.get('ultimaLeitura').data.Umidade}} <span style='font-size:0.6em'>%</span></div>\n      </div>\n    </div>\n    \n    \n    <div style='background:white; padding:20px; border-radius:8px; box-shadow:0 3px 6px rgba(0,0,0,0.1); border-top:4px solid #9b59b6'>\n      <div style='display:flex; justify-content:space-between; align-items:center; margin-bottom:15px'>\n        <h2 style='margin:0; color:#9b59b6'><i class='fa fa-fire'></i> Gás/Fumaça</h2>\n        <div style='font-size:2.2em; font-weight:bold'>{{global.get('ultimaLeitura').data.GasFumaca}} <span style='font-size:0.6em'>ppm</span></div>\n      </div>\n    </div>\n  </div>\n  \n  \n  <div style='display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); gap:20px'>\n    \n    <div style='background:white; padding:20px; border-radius:8px; box-shadow:0 3px 6px rgba(0,0,0,0.1)'>\n      <h2 style='margin-top:0; color:#2c3e50'><i class='fa fa-dashboard'></i> Status do Sistema</h2>\n      \n      <div style='background:{{global.get('ultimaLeitura').data.Alerta === \"ATIVO\" ? \"#ffeeee\" : \"#eeffee\"}}; \n                  padding:15px; border-radius:6px; margin-bottom:15px;\n                  border-left:5px solid {{global.get('ultimaLeitura').data.Alerta === \"ATIVO\" ? \"#e74c3c\" : \"#2ecc71\"}}'>\n        <div style='display:flex; justify-content:space-between; align-items:center'>\n          <div>\n            <h3 style='margin:0 0 5px 0; color:{{global.get('ultimaLeitura').data.Alerta === \"ATIVO\" ? \"#e74c3c\" : \"#27ae60\"}}'>\n              <i class='fa fa-{{global.get('ultimaLeitura').data.Alerta === \"ATIVO\" ? \"warning\" : \"check\"}}'></i>\n              {{global.get('ultimaLeitura').data.Alerta}}\n            </h3>\n            <p style='margin:0'>\n              <i class='fa fa-{{global.get('ultimaLeitura').data.Movimento === \"Detectado\" ? \"check\" : \"times\"}}'\n                  style='color:{{global.get('ultimaLeitura').data.Movimento === \"Detectado\" ? \"#27ae60\" : \"#e74c3c\"}}'></i>\n              Movimento: {{global.get('ultimaLeitura').data.Movimento}}\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>\n    \n    \n    <div style='background:white; padding:20px; border-radius:8px; box-shadow:0 3px 6px rgba(0,0,0,0.1)'>\n      <h2 style='margin-top:0; color:#2c3e50'><i class='fa fa-info-circle'></i> Informações do Dispositivo</h2>\n      <div ui-type='template' ui-field='info-template'></div>\n    </div>\n    \n    \n    <div style='background:white; padding:20px; border-radius:8px; box-shadow:0 3px 6px rgba(0,0,0,0.1)'>\n      <h2 style='margin-top:0; color:#2c3e50'><i class='fa fa-history'></i> Histórico Recente</h2>\n      <div ui-type='template' ui-field='historico-template'></div>\n    </div>\n  </div>\n</div>",
